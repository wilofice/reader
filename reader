class Memory:
    def __init__(self, path):
        path = Path(path).expanduser()
        path.parent.mkdir(parents=True, exist_ok=True)
        self.db = sqlite3.connect(path)
        self.db.execute("""CREATE TABLE IF NOT EXISTS documents (
            path TEXT PRIMARY KEY, digest TEXT NOT NULL, position INTEGER NOT NULL,
            length INTEGER NOT NULL, updated TEXT NOT NULL)""")
        columns = {row[1] for row in self.db.execute("PRAGMA table_info(documents)")}
        for name, definition in (
            ("reading_seconds", "REAL NOT NULL DEFAULT 0"),
            ("manual_words", "INTEGER NOT NULL DEFAULT 0"),
            ("manual_seconds", "REAL NOT NULL DEFAULT 0"),
            ("manual_digest", "TEXT NOT NULL DEFAULT ''"),
        ):
            if name not in columns:
                self.db.execute(f"ALTER TABLE documents ADD COLUMN {name} {definition}")
        self.db.commit()
        self.db.execute("""CREATE TABLE IF NOT EXISTS reading_cycles (
            path TEXT NOT NULL, digest TEXT NOT NULL, number INTEGER NOT NULL,
            started TEXT, finished TEXT, completed INTEGER NOT NULL DEFAULT 0,
            historical INTEGER NOT NULL DEFAULT 0, seconds REAL NOT NULL DEFAULT 0,
            base_seconds REAL NOT NULL DEFAULT 0,
            PRIMARY KEY (path, digest, number))""")
        self.db.execute("""CREATE TABLE IF NOT EXISTS discovered_documents (
            path TEXT PRIMARY KEY, discovered TEXT NOT NULL,
            modified_ns INTEGER NOT NULL, size INTEGER NOT NULL)""")
        self.db.commit()

        self.daily = DailyReading(self.db)

    def cycles(self, path, text, digest=None):
        digest = digest or hashlib.sha256(text.encode("utf-8")).hexdigest()
        return self.db.execute("""SELECT number, completed, seconds, historical, started, finished
            FROM reading_cycles WHERE path = ? AND digest = ? ORDER BY number""",
            (str(path), digest)).fetchall()

    def new_reading(self, path, text):
        digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
        if not self.cycles(path, text):
            old = self.db.execute("SELECT digest, position, length FROM documents WHERE path = ?", (str(path),)).fetchone()
            if old and old[0] == digest and old[1] >= old[2]:
                self.save(path, text, len(text))
        with self.db:
            rows = self.cycles(path, text)
            if not rows or not rows[-1][1]:
                raise ValueError("Terminez la lecture en cours avant de commencer la suivante.")
            seconds = self.db.execute("SELECT reading_seconds FROM documents WHERE path = ?", (str(path),)).fetchone()[0]
            self.db.execute("""INSERT INTO reading_cycles (path, digest, number, started, base_seconds)
                VALUES (?, ?, ?, datetime('now'), ?)""", (str(path), digest, rows[-1][0] + 1, seconds))
            self.db.execute("UPDATE documents SET position = 0 WHERE path = ?", (str(path),))

    def resume(self, path, text):
        digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
        adopt_pending(self.db, path, digest)
        row = self.db.execute("SELECT digest, position FROM documents WHERE path = ?", (str(path),)).fetchone()
        changed = row is not None and row[0] != digest
        return (min(max(row[1], 0), len(text)) if row and not changed else 0), changed

    def timing(self, path, displayed_text, changed=False):
        row = self.db.execute("""SELECT reading_seconds, manual_words, manual_seconds,
            manual_digest FROM documents WHERE path = ?""", (str(path),)).fetchone()
        digest = hashlib.sha256(displayed_text.encode("utf-8")).hexdigest()
        stats = ReadingStats(manual_digest=digest)
        if row:
            stats.seconds = row[0]
            if row[3] == digest and not changed:
                stats.manual_words, stats.manual_seconds = row[1], row[2]
        return stats

    def save(self, path, text, position, stats=None):
        digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
        with self.db:
            old = self.db.execute("SELECT digest, position, length, reading_seconds FROM documents WHERE path = ?", (str(path),)).fetchone()
            if not self.cycles(path, text):
                historical = bool(old and old[0] == digest and old[1] >= old[2])
                base = old[3] if old else 0
                self.db.execute("""INSERT INTO reading_cycles
                    (path, digest, number, started, completed, historical, base_seconds)
                    VALUES (?, ?, 1, CASE WHEN ? THEN NULL ELSE datetime('now') END, ?, ?, ?)""",
                    (str(path), digest, historical, historical, historical, base))
            self.db.execute("""INSERT INTO documents (path, digest, position, length, updated)
                VALUES (?, ?, ?, ?, strftime('%Y-%m-%d %H:%M:%f', 'now'))
                ON CONFLICT(path) DO UPDATE SET digest=excluded.digest,
                position=excluded.position, length=excluded.length, updated=excluded.updated""",
                (str(path), digest, position, len(text)))
            if stats is not None:
                self.db.execute("""UPDATE documents SET reading_seconds = ?, manual_words = ?,
                    manual_seconds = ?, manual_digest = ? WHERE path = ?""",
                    (stats.seconds, stats.manual_words, stats.manual_seconds, stats.manual_digest, str(path)))
            total = stats.seconds if stats is not None else (old[3] if old else 0)
            self.db.execute("""UPDATE reading_cycles SET seconds = MAX(0, ? - base_seconds),
                completed = ?, finished = CASE WHEN ? THEN datetime('now') ELSE NULL END
                WHERE path = ? AND digest = ? AND completed = 0
                AND number = (SELECT MAX(number) FROM reading_cycles WHERE path = ? AND digest = ?)""",
                (total, position >= len(text), position >= len(text), str(path), digest, str(path), digest))
            self.db.execute("DELETE FROM discovered_documents WHERE path = ?", (str(path),))

    def history(self):
        return self.db.execute("""SELECT path, position, length, updated, reading_seconds FROM (
            SELECT path, position, length, updated, reading_seconds, rowid AS ordering FROM documents
            UNION ALL
            SELECT q.path, 0, 0, q.discovered, 0, -q.rowid FROM discovered_documents q
            WHERE NOT EXISTS (SELECT 1 FROM documents d WHERE d.path=q.path))
            ORDER BY updated DESC, ordering DESC""").fetchall()

    def discover(self, folder):
        folder = Path(folder).expanduser().resolve(strict=True)
        if not folder.is_dir():
            raise ValueError(f'Le dossier de lecture est invalide : {folder}')
        extensions = {'.pdf', '.md', '.markdown', '.mdown'}
        found = []
        errors = []
        for root, directories, filenames in os.walk(folder, followlinks=False,
                                                     onerror=lambda error: errors.append(error)):
            directories[:] = [name for name in directories if not name.startswith('.')]
            for filename in filenames:
                if filename.startswith('.') or Path(filename).suffix.lower() not in extensions:
                    continue
                candidate = Path(root) / filename
                if candidate.is_symlink():
                    continue
                try:
                    stat = candidate.stat()
                    path = candidate.resolve(strict=True)
                except OSError:
                    continue
                if path.is_file():
                    found.append((str(path), stat.st_mtime_ns, stat.st_size))
                    if len(found) > 50000:
                        raise ValueError('Le dossier contient plus de 50 000 documents compatibles ; choisissez un dossier plus ciblé.')
        if errors and not found:
            raise ValueError(f'Impossible de parcourir le dossier de lecture : {errors[0]}')
        found_paths = {path for path, _, _ in found}
        stale = []
        for (raw_path,) in self.db.execute('SELECT path FROM discovered_documents'):
            try:
                Path(raw_path).relative_to(folder)
            except ValueError:
                continue
            if raw_path not in found_paths:
                stale.append(raw_path)
        if stale:
            with self.db:
                self.db.executemany('DELETE FROM discovered_documents WHERE path=?', ((path,) for path in stale))
        known = {row[0] for row in self.db.execute('SELECT path FROM documents')}
        known.update(row[0] for row in self.db.execute('SELECT path FROM discovered_documents'))
        discovered = sum(path not in known for path, _, _ in found)
        with self.db:
            for path, modified, size in found:
                self.db.execute("""INSERT INTO discovered_documents(path, discovered, modified_ns, size)
                    SELECT ?, strftime('%Y-%m-%d %H:%M:%f', 'now'), ?, ?
                    WHERE NOT EXISTS (SELECT 1 FROM documents WHERE path=?)
                    ON CONFLICT(path) DO UPDATE SET modified_ns=excluded.modified_ns, size=excluded.size""",
                    (path, modified, size, path))
        return discovered, len(found)

    def relocate(self, old_path, new_path, text):
        old_path, new_path = str(old_path), str(new_path)
        if old_path == new_path:
            return
        digest = hashlib.sha256(text.encode('utf-8')).hexdigest()
        old = self.db.execute('SELECT digest FROM documents WHERE path=?', (old_path,)).fetchone()
        target = self.db.execute('SELECT digest FROM documents WHERE path=?', (new_path,)).fetchone()
        if not old or old[0] != digest or target:
            return
        with self.db:
            self.db.execute('UPDATE documents SET path=? WHERE path=?', (new_path, old_path))
            self.db.execute('UPDATE reading_cycles SET path=? WHERE path=?', (new_path, old_path))
            self.db.execute('UPDATE daily_coverage SET path=? WHERE path=?', (new_path, old_path))

    def close(self):
        self.db.close()


@dataclass
class ReadingStats:
    seconds: float = 0.0
    manual_words: int = 0
    manual_seconds: float = 0.0
    manual_digest: str = ""

    @property
    def manual_wpm(self):
        if self.manual_words >= 20 and self.manual_seconds >= 10:
            return self.manual_words * 60 / self.manual_seconds
        return None


class ReadingClock:
    """Count visible reading time and calibrate only completed manual passages."""
    def __init__(self, stats, now=None, focused=None):
        self.stats = stats
        self.now = now or time.monotonic
        self.last_tick = self.now()
        self.active = False
        self.manual = None
        self.passage_seconds = 0.0
        self.sample_valid = True
        self.focused = focused or (lambda: True)
        self.was_focused = self.focused()

    def tick(self):
        current = self.now()
        elapsed = max(0, current - self.last_tick)
        self.last_tick = current
        focused = self.focused()
        # Ignore suspension/sleep and the intervals that cross a focus transition.
        if self.active and elapsed <= 3 and focused and self.was_focused:
            self.stats.seconds += elapsed
            if self.manual:
                self.passage_seconds += elapsed
        self.was_focused = focused

    def configure(self, active, manual):
        self.tick()
        if self.manual is not None and self.manual != manual:
            self.reset_passage()
        self.active, self.manual = active, manual

    def reset_passage(self):
        self.passage_seconds = 0.0
        self.sample_valid = False

    def complete_passage(self, words):
        self.tick()
        if self.manual and self.sample_valid and words > 0 and self.passage_seconds >= 0.2:
            self.stats.manual_words += words
            self.stats.manual_seconds += self.passage_seconds
        self.passage_seconds = 0.0
        self.sample_valid = True


class WordIndex:
    def __init__(self, text):
        self.length = len(text)
        self.starts = [match.start() for match in re.finditer(r"\S+", text)]

    def count(self, start, end=None):
        right = len(self.starts) if end is None else bisect_left(self.starts, end)
        return right - bisect_left(self.starts, start)


def remaining_estimate(words, position, stats, auto, speed, step=None, delay=None):
    count = words.count(position)
    if position >= words.length:
        return 0.0, "complete", None
    if auto:
        seconds = count * 60 / speed
        if step is not None and delay is not None:
            seconds = max(0, delay) + words.count(step) * 60 / speed
        return seconds, "configured_speed", speed
    rate = stats.manual_wpm
    if rate is None:
        return None, "calibrating", None
    return count * 60 / rate, "observed_manual_speed", rate


def duration(seconds, rounded_up=False):
    minutes = max(0, math.ceil(seconds / 60) if rounded_up else int(seconds // 60))
    hours, minutes = divmod(minutes, 60)
    return f'{hours:02d}h {minutes:02d}min'


def normalize_text(text):
    text = text.replace("\r\n", "\n").replace("\r", "\n").replace("\f", "\n\n").expandtabs(4)
    return "".join(c for c in text if c == "\n" or not unicodedata.category(c).startswith("C"))


def file_digest(path):
    digest = hashlib.sha256()
    with Path(path).open('rb') as source:
        while chunk := source.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def durable_reading_copy(path, folder):
    path = Path(path).expanduser().resolve(strict=True)
    folder = Path(folder).expanduser().resolve(strict=True)
    try:
        path.relative_to(folder)
        return path
    except ValueError:
        pass
    if path.suffix.lower() not in {'.pdf', '.md', '.markdown', '.mdown'}:
        return path
    target = folder / path.name
    source_digest = None
    if target.exists():
        if target.is_file() and target.stat().st_size == path.stat().st_size:
            source_digest = file_digest(path)
            if file_digest(target) == source_digest:
                return target.resolve()
        source_digest = source_digest or file_digest(path)
        target = folder / f'{path.stem}-{source_digest[:8]}{path.suffix.lower()}'
        if target.is_file() and target.stat().st_size == path.stat().st_size and file_digest(target) == source_digest:
            return target.resolve()
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=folder, prefix='.reader-copy-', delete=False) as output:
            temporary = Path(output.name)
        shutil.copy2(path, temporary)
        temporary.chmod(0o600)
        temporary.replace(target)
    except BaseException:
        if temporary:
            temporary.unlink(missing_ok=True)
        raise
    return target.resolve()


def load_document(path, encoding, with_pages=False):
    if path.suffix.lower() == ".pdf":
        if not shutil.which("pdftotext"):
            raise ValueError("PDF : installez Poppler avec `brew install poppler`.")
        result = subprocess.run(
            ["pdftotext", "-layout", "-enc", "UTF-8", str(path), "-"],
            capture_output=True, check=False,
        )
        if result.returncode:
            raise ValueError("Extraction PDF impossible : " + result.stderr.decode("utf-8", errors="replace").strip())
        text = result.stdout.decode("utf-8")
    else:
        text = path.read_text(encoding=encoding)
    # Stable offsets refer to this normalized text, not PDF pages or source bytes.
    page_starts = []
    if path.suffix.lower() == ".pdf":
        cursor = 0
        parts = text.split("\f")
        for index, part in enumerate(parts):
            if index == len(parts) - 1 and not part.strip() and len(parts) > 1:
                break
            page_starts.append(cursor)
            cursor += len(normalize_text(part)) + 2
    text = normalize_text(text)
    if not text.strip():
        raise ValueError("Aucun texte lisible. Un PDF scanné nécessite une reconnaissance OCR préalable.")
    return (text, page_starts) if with_pages else text


class PreviewHTML(HTMLParser):
    """Keep HTML text, hiding decorative tags and explicitly hidden content."""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack = []
        self.output = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        hidden = (any(item[1] for item in self.stack) or tag in ("script", "style", "head")
                  or "hidden" in attrs or "display:none" in (attrs.get("style") or "").replace(" ", "").lower())
        if not hidden and tag == "br":
            self.output.append("\n")
        if not hidden and tag == "img":
            self.output.append(attrs.get("alt") or "Image")
        if tag not in ("img", "br", "hr", "meta", "link", "input", "wbr", "source"):
            self.stack.append((tag, hidden))

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        self.handle_endtag(tag)

    def handle_endtag(self, tag):
        for index in range(len(self.stack) - 1, -1, -1):
            if self.stack[index][0] == tag:
                del self.stack[index:]
                break

    def handle_data(self, data):
        if not any(item[1] for item in self.stack):
            self.output.append(data)

    def convert(self, text):
        self.output = []
        self.feed(text)
        return "".join(self.output)


def markdown_preview(source):
    """Render common Markdown as terminal text, mapping back to source positions.

    Positions within a transformed line are interpolated; unchanged code lines
    keep exact offsets. This also migrates existing raw-Markdown reading positions.
    """
    references = set(re.findall(r"(?m)^ {0,3}\[([^\]]+)\]:", source))
    html = PreviewHTML()

    def inline(line):
        code = []

        def protect(match):
            code.append(match.group(2).replace("\n", " "))
            return f"\x00{len(code) - 1}\x00"

        line = re.sub(r"(?<!\\)(`+)(.+?)\1", protect, line)

        def protect_escape(match):
            code.append(match[1])
            return f"\x00{len(code) - 1}\x00"

        line = re.sub(r"\\([\\`*_{}\[\]()#+.!>|~-])", protect_escape, line)
        line = re.sub(r"\[\^[^\]]+\]", "", line)
        line = re.sub(r"!?\[([^\]]*)\]\((?:[^()\n]|\([^()\n]*\))*\)",
                      lambda m: m[1] or ("Image" if m[0].startswith("!") else ""), line)
        line = re.sub(r"!?\[([^\]]*)\]\[([^\]]*)\]", lambda m: (m[1] or "Image") if (m[2] or m[1]) in references else m[0], line)
        line = re.sub(r"!?\[([^\]]+)\]", lambda m: m[1] if m[1] in references else m[0], line)
        line = re.sub(r"<((?:https?://|mailto:)[^>]+)>", r"\1", line)
        line = html.convert(line)
        for delimiter in (r"\*\*", "__", "~~", r"\*", "_"):
            line = re.sub(r"(?<!\w)" + delimiter + r"(?=\S)(.+?)(?<=\S)" + delimiter + r"(?!\w)", r"\1", line)
        return re.sub(r"\x00(\d+)\x00", lambda m: code[int(m[1])], line)

    output, offsets = [], []
    source_start = 0
    fence = None
    in_definition = False
    for original in source.splitlines(keepends=True):
        line = original.rstrip("\n")
        rendered = None
        marker = re.match(r"^ {0,3}(`{3,}|~{3,})(.*)$", line)
        if fence:
            if marker and marker[1][0] == fence[0] and len(marker[1]) >= len(fence) and not marker[2].strip():
                fence = None
            else:
                rendered = line
        elif marker:
            fence = marker[1]
        elif re.match(r"^ {0,3}\[[^\]]+\]:", line):
            in_definition = True
        elif in_definition and (not line.strip() or line.startswith("    ")):
            pass
        else:
            in_definition = False
            if line.startswith("    "):
                rendered = line
            elif re.fullmatch(r"\s*(?:[-*_]\s*){3,}", line) or re.fullmatch(r"\s*[=-]{2,}\s*", line):
                rendered = ""
            elif "|" in line and re.fullmatch(r"[\s|:\-]+", line):
                rendered = None
            else:
                line = re.sub(r"^ {0,3}#{1,6}\s+(.+?)(?:\s+#+)?\s*$", r"\1", line)
                line = re.sub(r"^(\s*)>\s?", r"\1│ ", line)
                line = re.sub(r"^(\s*)[-+*]\s+\[([ xX])\]\s+", lambda m: m[1] + ("☐ " if m[2] == " " else "☑ "), line)
                line = re.sub(r"^(\s*)[-+*]\s+", r"\1• ", line)
                rendered = inline(line)
        if rendered is not None:
            rendered += "\n" if original.endswith("\n") else ""
            # Collapse empty decorative lines, retaining paragraph breaks.
            if rendered.strip() or (output and output[-1].strip()):
                output.append(rendered)
                offsets.extend(source_start + min(len(original) - 1, i * len(original) // max(1, len(rendered))) for i in range(len(rendered)))
        source_start += len(original)
    return "".join(output), offsets + [len(source)]


def cell_width(char):
    if unicodedata.combining(char):
        return 0
    return 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1


def rows(text, start, end, width, limit):
    """Return visual rows with exact source offsets, including consumed whitespace."""
    result = []
    while start < end and len(result) < limit:
        cursor, cells, last_space = start, 0, None
        while cursor < end and text[cursor] != "\n":
            advance = cell_width(text[cursor])
            if cells + advance > width:
                break
            cells += advance
            cursor += 1
            if text[cursor - 1].isspace():
                last_space = cursor
        if cursor < end and text[cursor] == "\n":
            cursor += 1
        elif cursor < end and last_space is not None:
            cursor = last_space
        if cursor == start:
            cursor += 1
        result.append((start, cursor, text[start:cursor].rstrip("\n")))
        start = cursor
    return result


def page(text, position, mode, size, width, height):
    end = len(text)
    if mode == "words":
        count = 0
        for match in re.finditer(r"\S+\s*", text[position:]):
            count += 1
            if count == size:
                end = position + match.end()
                break
        for formula in MARKED_MATH.finditer(text, position):
            if formula.start() < end < formula.end():
                end = formula.end()
                break
            if formula.start() >= end:
                break
    limit = min(size, height) if mode in ("lines", "scroll") else height
    visible = rows(text, position, end, width, limit)
    return visible, visible[-1][1] if visible else position


def previous(text, position, mode, size, width, height):
    if mode == "words":
        matches = list(re.finditer(r"\S+", text[:position]))
        candidate = matches[max(0, len(matches) - size)].start() if matches else 0
        # A word batch may occupy several screens: return its last screen.
        screens = rows(text, candidate, position, width, len(text) + 1)
    else:
        screens = rows(text, 0, position, width, len(text) + 1)
    count = 1 if mode == "scroll" else min(size, height) if mode == "lines" else height
    return screens[max(0, len(screens) - count)][0] if screens else 0


def clipped(text, width):
    result, cells = [], 0
    for char in text:
        advance = cell_width(char)
        if cells + advance > width:
            break
        result.append(char)
        cells += advance
    return "".join(result)


def select_history(screen, entries):
    """Choose a remembered document, newest first, without retyping its path."""
    screen.keypad(True)
    index = 0
    notice = '↑/↓ choisir · Entrée reprendre · q quitter'
    while True:
        screen.erase()
        height, width = screen.getmaxyx()

        def put(y, value, attr=0):
            if 0 <= y < height:
                try:
                    screen.addnstr(y, 2, value, max(0, width - 4), attr)
                except curses.error:
                    pass

        put(0, 'HISTORIQUE DES DOCUMENTS', curses.A_BOLD)
        put(1, 'Du plus récemment consulté au plus ancien')
        if not entries:
            put(3, 'Aucun document mémorisé.')
            put(height - 2, 'q / Échap : quitter')
            screen.refresh()
            if read_catalog_key(screen) in (ord('q'), 27, 10, 13, curses.KEY_ENTER):
                return None
            continue

        visible_count = max(1, height - 7)
        start = min(max(0, index - visible_count + 1), max(0, len(entries) - visible_count))
        for row_index, (raw_path, position, length, _updated, seconds) in enumerate(
                entries[start:start + visible_count]):
            absolute_index = start + row_index
            path = Path(raw_path)
            suffix = (f'{position / length:5.1%} · {duration(seconds)}'
                      if length else 'nouveau')
            title_width = max(8, width - 10 - len(suffix))
            title = clipped(path.name, title_width)
            if title != path.name and title_width:
                title = clipped(title, max(1, title_width - 1)) + '…'
            missing = ' ⚠' if not path.is_file() else ''
            line = f'{absolute_index + 1:2}. {title:<{title_width}} {suffix}{missing}'
            selected = curses.A_REVERSE | curses.A_BOLD if absolute_index == index else 0
            put(row_index + 3, line, selected)

        selected_path, _, _, updated, _ = entries[index]
        put(height - 3, f'{updated} UTC · {selected_path}', curses.A_DIM)
        put(height - 2, notice)
        screen.refresh()
        key = read_catalog_key(screen)
        if key in (ord('q'), 27):
            return None
        if key in (curses.KEY_UP, ord('k')):
            index = max(0, index - 1)
        elif key in (curses.KEY_DOWN, ord('j')):
            index = min(len(entries) - 1, index + 1)
        elif key == curses.KEY_HOME:
            index = 0
        elif key == curses.KEY_END:
            index = len(entries) - 1
        elif key in (10, 13, curses.KEY_ENTER):
            path = Path(entries[index][0]).expanduser()
            if path.is_file():
                return path
            notice = 'Fichier introuvable : déplacez la sélection ou appuyez sur q.'


def terminal_accent():
    """Keep the terminal background and fall back to monochrome when needed."""
    if "NO_COLOR" in os.environ:
        return curses.A_BOLD
    try:
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            return curses.color_pair(1)
    except curses.error:
        pass
    return curses.A_BOLD


def run_ui(screen, text, path, memory, args, position, changed, source=None, offsets=None, stats=None, page_starts=None, visual_index=None):
    source = text if source is None else source
    stats = stats if stats is not None else memory.timing(path, text, changed)
    clock = ReadingClock(stats, focused=lambda: is_focused(screen))
    words_index = WordIndex(text)
    if path.suffix.lower() in ('.md', '.markdown', '.mdown'):
        daily_text, daily_offsets = markdown_preview(source)
    else:
        daily_text, daily_offsets = source, None
    daily_index = DailyWordIndex(daily_text, daily_offsets)
    total_words_label = ' · ' + f'{len(daily_index.anchors):,}'.replace(',', ' ') + ' mots'
    daily_digest = hashlib.sha256(source.encode('utf-8')).hexdigest()
    focus = FocusSession()
    daily_refresh = 0.0
    daily_day = memory.daily.day
    daily_words, daily_goal = memory.daily.words(), memory.daily.goal
    images = markdown_images(source, path) if path.suffix.lower() in ('.md', '.markdown', '.mdown') else []
    speech = None
    voice_enabled = getattr(args, 'speak', False)
    voice_error = False
    audio_rate = getattr(args, 'audio_rate', 1.0)
    companion = None
    panel_open = getattr(args, 'companion', False)
    panel_passage = None
    panel_offset = 0

    def source_position():
        return offsets[position] if offsets is not None else position

    try:
        curses.curs_set(0)
    except curses.error:
        pass
    accent = terminal_accent()
    screen.timeout(1000)
    auto = args.auto or args.mode == "scroll"
    paused = False
    speed = args.wpm
    jump_step = 0.001  # 0,1 % du document, aligné sur la position de progression
    proportional_mode = False
    deadline = None
    window_was_active = is_focused(screen)
    focus_delay = None
    stack = []
    notice = "Fichier modifié : reprise au début." if changed else ""
    last_saved = None
    last_save_time = time.monotonic()
    last_layout = None
    help_open = False
    reference_open = False
    zen = getattr(args, "zen", False)
    help_offset = 0
    help_lines = [
        "Raccourcis de lecture", "",
        "n / Entrée / → / Page suiv.    Passage suivant",
        "b / ← / Page préc.            Passage précédent, puis pause",
        "h / l             Passage précédent / suivant, comme les flèches",
        "1 / 2 / 3         Passages proportionnels : 1 % / 0,1 % / 0,01 %",
        "Espace / p / P    Pause / reprise, dans tous les modes",
        "t / T             Activer / arrêter la voix",
        "e                 Ouvrir / fermer l'accompagnement IA",
        "1 à 5 (panneau)   Contexte, question, indice, résumé, QCM",
        "A à D / R         Répondre au QCM / révéler une réponse ouverte",
        "{ / }             Défiler dans l'accompagnement",
        "+ / - avec voix   Tempo audio ; relit le passage courant",
        "a                 Activer ou suspendre l'automatique",
        "j / k             Réduire / augmenter le passage",
        "+ / -             Accélérer / ralentir de 25 mots/min",
        "g                 Revenir au début",
        "z                 Activer / quitter ZEN",
        "i                 Référence de page ou ligne source",
        "v                 Pages PDF / images Markdown du passage",
        "f                 Démarrer / arrêter le focus (chrono ou minuteur)",
        "N                 Nouvelle lecture après la fin",
        "q                 Sauvegarder et quitter", "",
        "[ et ] règlent aussi la taille du passage.",
        "Police plus grande : utilisez le zoom du terminal.",
        "? / Échap          Fermer cette aide",
    ]

    def save(force=False):
        nonlocal last_saved, last_save_time, notice
        clock.tick()
        if focus.update(stats.seconds):
            notice = 'Focus terminé · f : fermer le minuteur.'
            try:
                curses.beep()
            except curses.error:
                pass
        now = time.monotonic()
        if force or last_saved is None or position != last_saved or now - last_save_time >= 5:
            memory.save(path, source, source_position(), stats)
            last_saved, last_save_time = position, now

    try:
        while True:
            save()
            height, width = screen.getmaxyx()
            screen.erase()
            window_active = is_focused(screen)
            if not window_active:
                if window_was_active:
                    clock.reset_passage()
                    if deadline is not None:
                        focus_delay = max(0, deadline - time.monotonic())
                deadline = None
            elif not window_was_active and focus_delay is not None:
                deadline = time.monotonic() + focus_delay
                focus_delay = None
            window_was_active = window_active
            focus_large = focus.visible and height >= 14 and width >= 65
            focus_paused = paused or help_open or not window_active or position >= len(text)
            focus_marker = '✓' if focus.state == 'finished' else 'Ⅱ' if focus_paused else '▶'
            focus_label = 'FOCUS TERMINÉ' if focus.state == 'finished' else '▶ ' + ('CHRONO' if focus.mode == 'chrono' else 'MINUTEUR')
            if focus.visible and focus.state == 'running' and focus_paused:
                focus_label = ('CHRONO' if focus.mode == 'chrono' else 'MINUTEUR') + ' · pause'
            focus_lines = big_clock(focus.display) if focus_large else [focus.display]
            focus_width = max(map(len, [focus_label] + focus_lines)) if focus_large else len(f'Focus {focus_marker} {focus.display}')
            focus_left = max(0, width - focus_width - 2)

            def put(y, value, style=0, x=0, chrome=True):
                if zen and not help_open and chrome:
                    return
                if 0 <= y < height:
                    try:
                        available = width - x - 1
                        if focus.visible and y < (4 if focus_large else 1) and x < focus_left:
                            available = min(available, focus_left - x - 2)
                        screen.addstr(y, x, clipped(value, max(0, available)), style)
                    except curses.error:
                        pass

            if height < 8 or width < 35:
                if speech:
                    speech.pause()
                clock.configure(False, not auto)
                put(0, "Agrandissez le terminal (35 × 8 min).", chrome=False)
                put(1, "q : quitter et sauvegarder", chrome=False)
                screen.refresh()
                key = screen.getch()
                deadline = None
                if key in (ord("q"), 27):
                    break
                continue

            spacious = height >= 14
            body_start = 5 if spacious else 3
            body_height = height - body_start - 4
            if zen and not help_open:
                body_start, body_height = 2, height - 4
            if focus_large:
                body_start = 6 if zen and not help_open else 7
                body_height = height - body_start - (2 if zen and not help_open else 4)
            quote_row = None
            if spacious and not (zen and not help_open):
                quote_row = 4 if focus_large else 3
                body_start = quote_row + 3
                body_height = height - body_start - 4
            panel_visible = panel_open and not zen and not help_open
            panel_side = panel_visible and width >= 110
            panel_overlay = panel_visible and not panel_side
            body_width = min(76, int(width * 0.60) - 5) if panel_side else min(76, width - 6)
            body_left = 2 if panel_side else (width - body_width) // 2
            panel_left = body_left + body_width + 4 if panel_side else body_left
            panel_width = width - panel_left - 3 if panel_side else body_width
            layout = (body_height, body_width)
            if layout != last_layout:
                deadline = None
                if last_layout is not None:
                    clock.reset_passage()
                last_layout = layout
            proportional_words = max(1, round(len(words_index.starts) * jump_step))
            display_mode = "words" if proportional_mode else args.mode
            display_size = proportional_words if proportional_mode else args.size
            visible, end = page(text, position, display_mode, display_size, body_width, body_height)
            step = visible[0][1] if display_mode == "scroll" and visible else end
            done = position >= len(text)
            current_panel_passage = (position, step)
            if current_panel_passage != panel_passage:
                if companion:
                    companion.cancel()
                panel_passage, panel_offset = current_panel_passage, 0
            if companion:
                companion.poll()
            if done:
                auto = False
            audio_active = not done and not paused and not help_open and not panel_overlay and window_active
            if voice_enabled and not done:
                if speech is None:
                    speech = Speech(getattr(args, 'tts', 'ollama'), getattr(args, 'speech_model', 'phonon:40m-fr'),
                                    getattr(args, 'voice', 'default'), getattr(args, 'ollama_url', 'http://127.0.0.1:11434'),
                                    args.wpm)
                try:
                    speech.sync((position, step, audio_rate), text[position:step], audio_active, audio_rate)
                except (OSError, ValueError) as error:
                    notice = str(error)
                    voice_error = True
                    voice_enabled, paused = False, True
                    speech.stop()
                deadline = None
            elif speech:
                speech.stop()
            clock.configure(audio_active and not paused and (not voice_enabled or speech.state == 'playing'),
                            not auto and not voice_enabled)
            if auto and not voice_enabled and audio_active and deadline is None:
                words = max(1, words_index.count(position, step))
                deadline = time.monotonic() + max(0.25, words * 60 / speed)

            estimate, basis, rate = remaining_estimate(
                words_index, position, stats, auto, speed, step,
                None if deadline is None else deadline - time.monotonic(),
            )
            if voice_enabled and not done:
                estimate, basis, rate = None, 'audio', None
            page_label = ""
            visual_hint, visual_pending, visual_pages = None, False, []
            if page_starts:
                first_page = min(len(page_starts), bisect_right(page_starts, source_position()))
                source_end = offsets[end] if offsets is not None else end
                last_page = min(len(page_starts), bisect_right(page_starts, max(source_position(), source_end - 1)))
                page_label = str(first_page) if first_page == last_page else f"{first_page}–{last_page}"
                if visual_index is not None:
                    visual_hint, visual_pending, visual_pages = visual_index.visible(first_page, last_page)
            visual_message = (f"{visual_label(visual_hint)} · p. PDF {visual_hint['page']} · v voir"
                              if visual_hint else "")
            source_end = offsets[end] if offsets is not None else end
            passage_images = [item for item in images
                              if item['start'] < source_end and item['end'] > source_position()]
            media_choices = [dict(page=item['page'], title=f"Page PDF {item['page']} · {visual_label(item)}")
                             for item in visual_pages if visual_label(item)]
            if passage_images:
                visual_message = f"{len(passage_images)} image(s) Markdown · v voir"
                media_choices = passage_images
            elif len(media_choices) > 1:
                visual_message += f" · +{len(media_choices) - 1} page(s)"

            cycles = memory.cycles(path, source, digest=daily_digest)
            completed = sum(row[1] for row in cycles)
            cycle_number = cycles[-1][0] if cycles else 1
            title_width = max(0, min(width - 3, focus_left - 4) if focus.visible else width - 3)
            name_width = max(0, title_width - sum(map(cell_width, total_words_label)))
            title = clipped(path.name, name_width)
            if sum(map(cell_width, path.name)) > name_width and name_width:
                title = clipped(path.name, name_width - 1) + '…'
            put(0, title + total_words_label, curses.A_BOLD, x=2)
            mode_label = "Proportionnel" if proportional_mode else {"lines": "Lignes", "words": "Mots", "scroll": "Défilement"}[args.mode]
            reading_state = "Lecture terminée" if done else "En pause · aide" if help_open else "En pause" if paused else "Lecture automatique" if auto else "Lecture manuelle"
            if not window_active:
                reading_state = 'Pause · fenêtre inactive'
            rhythm = f"{speed} mots/min" if auto else f"{rate:.0f} mots/min observés" if rate else "Rythme à calibrer"
            metadata = f"{mode_label} · {rhythm} · {reading_state}"
            if width < 65:
                reading_state = "Fin" if done else "Pause" if help_open or paused else "Auto" if auto else "Manuel"
                if not window_active:
                    reading_state = 'Pause fenêtre'
                rhythm = f"{rate:.0f} m/min" if rate else "calibrage"
                metadata = f"{mode_label} · {rhythm} · {reading_state}"
            if done:
                metadata = f"{mode_label} · {reading_state}"
            if voice_enabled and speech and not done:
                metadata = f'{mode_label} · Voix : {speech.label} · ×{audio_rate:.1f} · t arrêter'
            elif voice_error:
                metadata = 'Voix indisponible · i : détails et commande de réparation'
            put(1, metadata, accent, x=2)
            unit = "mots" if proportional_mode or args.mode == "words" else "lignes"
            if spacious:
                setting = (f"Passage : ≈{proportional_words} mots · {jump_step * 100:g}%"
                           if proportional_mode else f"Passage : {args.size} {unit}")
                setting += f" · Lecture {cycle_number}"
                hint = "    h retour · l suivant" if proportional_mode else "    j réduire · k augmenter"
                if width >= 65:
                    setting += hint
                put(2, setting, x=2)
            if quote_row is not None:
                put(quote_row, READING_QUOTE, curses.A_DIM, x=2)
            put(body_start - 2 if spacious else 2, "─" * (width - 4), curses.A_DIM, x=2)
            if help_open:
                info = ["Référence du passage", "", str(path)]
                if notice:
                    info += [notice, ""]
                if page_starts:
                    info += [f"Page(s) PDF : {page_label} / {len(page_starts)} (index physique)",
                             "Le numéro imprimé sur la page peut être différent.",
                             "Repérage structurel : images et tracés ; pas d'interprétation."]
                    if visual_message:
                        info += [visual_message]
                    if visual_pending:
                        info += ["Analyse visuelle en cours pour certaines pages."]
                    for item in visual_pages:
                        info += [f"Page {item['page']} : {item['images']} image(s), {item['paths']} indice(s) de tracés."]
                        if item.get("error"):
                            info += ["Analyse indisponible ou incomplète : " + item["error"]]
                        if 'formulas' in item:
                            info += [f"Formules : {item['formulas']} zone(s) probable(s) · méthode {item['formula_method']}"]
                        if item.get('formula_error'):
                            info += ['Repérage des formules : ' + item['formula_error']]
                    info += ["Une référence textuelle peut renvoyer à une autre page.",
                             "L'absence d'indicateur ne garantit pas l'absence de figure."]
                else:
                    info += [f"Ligne source : {source.count(chr(10), 0, source_position()) + 1}"]
                    for item in passage_images:
                        info += ["Image : " + item['title'], str(item['path'])]
                info += ["", f"Lecture {cycle_number} · {completed} terminée(s)",
                         f"Relectures terminées : {max(0, completed - 1)}",
                         "", "i / ? / Échap : revenir au passage"]
                help_text = "\n".join(info if reference_open else help_lines)
                help_view = [row[2] for row in rows(help_text, 0, len(help_text), body_width, len(help_text))]
                help_offset = min(help_offset, max(0, len(help_view) - body_height))
                for index, line in enumerate(help_view[help_offset:help_offset + body_height]):
                    put(body_start + index, line, curses.A_BOLD if help_offset + index == 0 else 0, x=body_left)
            elif not panel_overlay:
                for index, (_, _, line) in enumerate(visible):
                    put(body_start + index, line, x=body_left, chrome=False)
                if done:
                    put(body_start, "Fin de lecture. N : relire.", curses.A_BOLD, x=body_left, chrome=False)
                    if body_height > 1:
                        put(body_start + 1, "g / b : revoir dans ce cycle", x=body_left, chrome=False)
            if page_starts and not help_open:
                unavailable = any(item.get("error") or item.get('formula_error') for item in visual_pages)
                page_status = f"Page(s) PDF {page_label}/{len(page_starts)} · v image · i référence · h/l passage"
                if visual_pending:
                    page_status += " · analyse…"
                elif unavailable:
                    page_status += " · analyse incomplète"
                put(height - 2, notice or page_status, curses.A_DIM)
            if panel_visible:
                if companion is None:
                    companion = Companion(getattr(args, 'llm_model', ''),
                                          getattr(args, 'ollama_url', 'http://127.0.0.1:11434'))
                panel_text = '\n'.join(companion.display())
                panel_lines = [row[2] for row in rows(panel_text, 0, len(panel_text), panel_width, len(panel_text))]
                panel_offset = min(panel_offset, max(0, len(panel_lines) - body_height))
                for index, line in enumerate(panel_lines[panel_offset:panel_offset + body_height]):
                    put(body_start + index, clipped(line, panel_width),
                        curses.A_DIM if index else accent, x=panel_left, chrome=False)
                if panel_side:
                    for row in range(body_start, body_start + body_height):
                        put(row, '│', curses.A_DIM, x=panel_left - 2)
            if visual_message and not help_open and not panel_overlay:
                # Keep the cue in the reading column, without moving the passage.
                hint_row = (body_start - 1 if focus.visible else 0) if zen else body_start - 1
                hint_left = min(body_left, max(2, width - 2 - sum(map(cell_width, visual_message))))
                put(hint_row, visual_message, accent | curses.A_BOLD, x=hint_left, chrome=False)
            fraction = source_position() / len(source)
            bar_width = width - 10
            filled, remainder = divmod(int(bar_width * 8 * fraction), 8)
            partial = "▏▎▍▌▋▊▉"[remainder - 1] if remainder else ""
            bar = "█" * filled + partial + "░" * (bar_width - filled - bool(partial))
            put(height - 3, f"[{bar}] {fraction:6.1%}", accent)
            remaining_label = "calibrage" if estimate is None else ("" if basis == "complete" else "≈ ") + duration(estimate, rounded_up=True)
            if basis == 'audio':
                remaining_label = 'non estimé (audio)'
            estimate_label = "auto" if basis == "configured_speed" else "observé" if basis == "observed_manual_speed" else ""
            timing = f"Temps cumulé : {duration(stats.seconds)} · Reste {remaining_label} {estimate_label}"
            if width < 65:
                timing = f"Lu {duration(stats.seconds)} · reste {remaining_label}"
            put(height - 4, timing, curses.A_DIM)
            if help_open:
                put(height - 2, "↑/↓ : défiler · ?/Échap : retour")
                footer = "Lecture suspendue pendant l'aide"
            else:
                if not page_starts:
                    put(height - 2, notice or "n/l passage suivant · b/h précédent · 1/2/3 : taille proportionnelle",
                        curses.A_DIM)
                footer = ('f focus · p pause · z ZEN · i référence · ? aide · q quitter' if width >= 80
                          else 'f focus · ? aide · q quitter' if width >= 60 else 'f focus · q quitter')
            now = time.monotonic()
            if now - daily_refresh >= 1 or daily_day != memory.daily.day:
                daily_day = memory.daily.day
                daily_words, daily_goal = memory.daily.words(), memory.daily.goal
                daily_refresh = now
            counter = f'{daily_words}/{daily_goal} mots'
            daily_left = max(0, width - len(counter) - 2)
            put(height - 1, clipped(footer, max(0, daily_left - 2)), curses.A_DIM)
            put(height - 1, counter, accent if daily_words >= daily_goal else curses.A_DIM, x=daily_left, chrome=False)
            if focus.visible:
                if focus_large:
                    put(0, focus_label, accent, x=focus_left, chrome=False)
                    for row, line in enumerate(focus_lines, 1):
                        put(row, line, accent | curses.A_BOLD, x=focus_left, chrome=False)
                else:
                    put(0, f'Focus {focus_marker} {focus.display}', accent | curses.A_BOLD, x=focus_left, chrome=False)
            screen.refresh()
            wait_ms = 100 if voice_enabled else 250 if companion and companion.process else 1000
            if visual_pending and window_active:
                wait_ms = 250
            if deadline is not None and window_active:
                wait_ms = min(wait_ms, max(1, math.ceil((deadline - time.monotonic()) * 1000)))
            screen.timeout(wait_ms)
            key = screen.getch()
            clock.tick()
            advance = False
            if key == FOCUS_EVENT:
                continue
            if not is_focused(screen) and key not in (ord('q'), 27):
                continue
            if key in (ord("?"), ord("i")) or (help_open and key == 27):
                reference_open = key == ord("i") and not help_open
                help_open = not help_open
                help_offset = 0
                deadline = None
                continue
            if key in (ord("q"), 27):
                break
            if key == curses.KEY_RESIZE:
                deadline = None
                continue
            if key == ord("v") and not help_open:
                if speech:
                    speech.pause()
                if not page_starts and not passage_images:
                    notice = "Aucune image locale dans ce passage ; aperçu disponible pour les PDF."
                    continue
                clock.configure(False, not auto)
                save(force=True)
                def record_inspection(seconds):
                    stats.seconds += seconds
                    save()

                try:
                    choice = choose_media(screen, media_choices) if media_choices else dict(page=first_page)
                    if choice is not None:
                        if 'path' in choice:
                            inspect_image(screen, choice['path'], getattr(args, 'graphics', 'auto'),
                                          on_time=record_inspection)
                        else:
                            inspect_pdf(screen, path, choice['page'], len(page_starts),
                                        getattr(args, "graphics", "auto"), on_time=record_inspection)
                    notice = "Retour au passage sauvegardé."
                except (OSError, ValueError) as error:
                    notice = str(error)
                    paused = True
                    if zen:
                        help_open, reference_open = True, True
                finally:
                    deadline = None
                    clock.reset_passage()
                    clock.tick()
                    save(force=True)
                continue
            if help_open:
                if key in (curses.KEY_DOWN, curses.KEY_NPAGE, ord(" ")):
                    help_offset = min(max(0, len(help_view) - body_height), help_offset + 1)
                elif key in (curses.KEY_UP, curses.KEY_PPAGE):
                    help_offset = max(0, help_offset - 1)
                continue
            if key == ord('e'):
                panel_open = not panel_open
                if panel_open:
                    paused = True
                    notice = 'Accompagnement ouvert · 1 à 5 : choisir · Espace : reprendre · e fermer.'
                elif companion:
                    companion.cancel()
                deadline = None
                continue
            if panel_visible and key in map(ord, COMPANION_MODES):
                paused, deadline, panel_offset = True, None, 0
                if speech:
                    speech.pause()
                reference = f'p. PDF {page_label}' if page_starts else f'Ligne source {source.count(chr(10), 0, source_position()) + 1}'
                try:
                    companion.request(text[position:step], COMPANION_MODES[chr(key)], reference)
                except (OSError, ValueError) as error:
                    notice = str(error)
                continue
            if panel_visible and key in (ord('{'), ord('}')):
                panel_offset = max(0, panel_offset + (-max(1, body_height // 2) if key == ord('{') else max(1, body_height // 2)))
                continue
            if panel_visible and companion and companion.result:
                if companion.mode == 'qcm' and key in map(ord, 'ABCD'):
                    if companion.choice is None:
                        companion.choice = key - ord('A')
                    continue
                if companion.mode == 'question' and key == ord('R'):
                    companion.revealed = True
                    continue
            if key == ord("z"):
                zen = not zen
                deadline = None
                continue
            if key in (ord("1"), ord("2"), ord("3")):
                jump_step = {ord("1"): 0.01, ord("2"): 0.001, ord("3"): 0.0001}[key]
                proportional_mode = True
                proportional_words = max(1, round(len(words_index.starts) * jump_step))
                clock.reset_passage()
                deadline = None
                notice = (f"Passages de {jump_step * 100:g}% · environ {proportional_words} mots. "
                          "l valide la suite · h revient au passage précédent.")
                continue
            if key == ord('f'):
                if speech:
                    speech.pause()
                if focus.visible:
                    focus.stop()
                    notice = 'Focus arrêté.'
                elif done:
                    notice = 'Lecture terminée : b pour revoir, N pour relire, puis f.'
                else:
                    clock.configure(False, not auto)
                    save(force=True)
                    selection = choose_focus(screen, memory.daily.get('focus_mode', 'timer'),
                                             int(memory.daily.get('focus_minutes', '5')))
                    if selection is not None:
                        mode, minutes = selection
                        memory.daily.set('focus_mode', mode)
                        memory.daily.set('focus_minutes', minutes)
                        focus.start(mode, minutes, stats.seconds)
                        paused = False
                        notice = 'Focus actif · f arrêter · p pause.'
                deadline = None
                clock.reset_passage()
                continue
            if key == ord("N"):
                if done:
                    save(force=True)
                    memory.new_reading(path, source)
                    position, stack, deadline = 0, [], None
                    auto, paused = args.auto or args.mode == "scroll", False
                    clock.reset_passage()
                else:
                    notice = "Terminez cette lecture avant d'en commencer une autre."
                continue
            if key in (ord('t'), ord('T')):
                voice_error = False
                voice_enabled = not voice_enabled
                notice = 'Voix activée · Espace : pause/reprise · t : arrêter.' if voice_enabled else 'Voix arrêtée.'
                auto, deadline = False, None
                if voice_enabled:
                    paused = False
                elif speech:
                    speech.stop()
                clock.reset_passage()
            elif key in (ord("n"), ord("l"), curses.KEY_RIGHT, curses.KEY_DOWN, curses.KEY_NPAGE, 10, 13):
                advance = True
            elif key in (ord(' '), ord('p'), ord('P')):
                paused, deadline = not paused, None
            elif key == ord("a"):
                voice_enabled = False
                if speech:
                    speech.stop()
                auto, deadline = not auto, None
                paused = not auto
            elif key in (ord("+"), ord("="), ord("-")):
                if voice_enabled:
                    audio_rate = round(max(0.5, min(2.0, audio_rate + (-0.1 if key == ord('-') else 0.1))), 1)
                    notice = 'Tempo audio modifié ; reprise du passage courant.'
                else:
                    speed = max(10, min(3000, speed + (-25 if key == ord("-") else 25)))
                deadline = None
            elif key in (ord("j"), ord("k"), ord("["), ord("]")):
                if proportional_mode:
                    proportional_mode = False
                size_unit = "mots" if args.mode == "words" else "lignes"
                amount = 10 if args.mode == "words" else 1
                args.size = max(1, args.size + (amount if key in (ord("k"), ord("]")) else -amount))
                clock.reset_passage()
                deadline = None
                notice = f"Passage : {args.size} {size_unit} (limité à la fenêtre)."
            elif key in (ord("b"), ord("h"), curses.KEY_LEFT, curses.KEY_UP, curses.KEY_PPAGE):
                position = stack.pop() if stack else previous(text, position, display_mode, display_size, body_width, body_height)
                clock.reset_passage()
                paused = paused or auto or voice_enabled
                auto, deadline = False, None
            elif key == ord("g"):
                stack.append(position)
                position, auto, deadline = 0, False, None
                clock.reset_passage()
                paused = False
            elif key == -1 and voice_enabled and speech and speech.finished and audio_active:
                advance = True
            elif key == -1 and auto and not voice_enabled and audio_active and deadline is not None and time.monotonic() >= deadline:
                advance = True
            if advance and not done:
                clock.complete_passage(words_index.count(position, step))
                source_step = offsets[step] if offsets is not None else step
                word_start, word_end = daily_index.interval(source_position(), source_step)
                memory.daily.record(path, daily_digest, cycle_number, word_start, word_end)
                daily_refresh = 0.0
                stack.append(position)
                position = step
                paused = False
                deadline = None
                notice = ""
    finally:
        clock.configure(False, False)
        if speech:
            speech.close()
        if companion:
            companion.close()
        save(force=True)


def positive(value):
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError("La valeur doit être strictement positive.")
    return number


def focus_minutes(value):
    minutes = positive(value)
    if minutes < 5:
        raise argparse.ArgumentTypeError('La durée minimum est de 5 minutes.')
    return minutes


def audio_tempo(value):
    rate = float(value)
    if not math.isfinite(rate) or not 0.5 <= rate <= 2:
        raise argparse.ArgumentTypeError('Le tempo audio doit être compris entre 0.5 et 2.')
    return rate


def run_with_focus(screen, *args):
    enabled = enable_reports()
    try:
        try:
            curses.set_escdelay(25)
        except (AttributeError, curses.error):
            pass
        return run_ui(FocusScreen(screen, TerminalFocus()), *args)
    finally:
        if enabled:
            disable_reports()


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == 'sync':
        try:
            return sync_main(argv[1:], state_path(), Memory)
        except (OSError, ValueError, sqlite3.Error, subprocess.SubprocessError) as error:
            print(f'reader sync : {error}', file=sys.stderr)
            return 1
    parser = argparse.ArgumentParser(description=__doc__, epilog='Synchronisation sans cloud : reader sync --help')
    parser.add_argument("file", nargs="?", type=Path, help="fichier texte, Markdown ou PDF")
    imports = parser.add_mutually_exclusive_group()
    imports.add_argument('-c', '--clipboard', action='store_true', help='importer le presse-papiers et lire')
    imports.add_argument('--paste', action='store_true', help='coller un texte, puis Ctrl-D pour lire')
    imports.add_argument('--open', dest='saved_name', metavar='NOM', help='reprendre un texte importé par son nom')
    imports.add_argument('--library', action='store_true', help='lister les textes importés et leur progression')
    parser.add_argument('-F', '--folder', '--inbox', type=Path, help='mémoriser le dossier local de PDF et Markdown à découvrir')
    parser.add_argument('--catalog', action='store_true', help='ouvrir le catalogue de lectures recommandées dans le terminal')
    parser.add_argument('--download-library', action='store_true', help='télécharger les documents disponibles depuis leurs sources officielles')
    parser.add_argument('--download-book', metavar='ID', help='télécharger un document du catalogue')
    parser.add_argument('--attach-book', nargs=2, metavar=('ID', 'FICHIER'), help='rattacher un document local à une fiche du catalogue')
    parser.add_argument('--open-book', metavar='ID', help='lire ou reprendre un document du catalogue')
    parser.add_argument('-n', '--name', help='nom du texte à importer (sinon demandé dans le terminal)')
    parser.add_argument('--speak', action='store_true', help='activer la voix dès l’ouverture (sinon touche t)')
    parser.add_argument('--tts', choices=('ollama', 'say'), default='ollama', help='moteur vocal, utilisé seulement à la demande')
    parser.add_argument('--speech-model', help='modèle vocal Ollama (automatique pour les livres du catalogue)')
    parser.add_argument('--voice', default='default', help='voix du moteur choisi')
    parser.add_argument('--audio-rate', type=audio_tempo, default=1.0, help='tempo audio de 0.5 à 2 (FFmpeg si différent de 1)')
    parser.add_argument('--ollama-url', default='http://127.0.0.1:11434', help='adresse du serveur Ollama local')
    parser.add_argument('--companion', action='store_true', help='ouvrir le panneau pédagogique (touche e)')
    parser.add_argument('--llm-model', default='granite4:latest', help='modèle texte Ollama (téléchargé à sa première utilisation)')
    parser.add_argument("-m", "--mode", choices=("l", "w", "s", "lines", "words", "scroll"), default="lines", help="l = lignes, w = mots, s = défilement (noms longs acceptés)")
    parser.add_argument("-s", "--size", type=positive, help="lignes ou mots par passage (défaut : 15 lignes / 120 mots)")
    parser.add_argument("-a", "--auto", action="store_true", help="avancer automatiquement")
    parser.add_argument("-w", "--wpm", type=positive, default=200, help="vitesse en mots/minute (défaut : 200)")
    parser.add_argument("-r", "--restart", action="store_true", help="reprendre au début")
    parser.add_argument("-z", "--zen", action="store_true", help="lecture sans en-tête ni compteurs (touche z)")
    parser.add_argument("--preview", "--graphics", dest="graphics", choices=("auto", "iterm2", "quicklook", "kitty", "iterm", "sixels", "symbols"), default="auto", help="aperçu PDF : automatique, iTerm2 ou Quick Look (touche v)")
    parser.add_argument("--new-reading", action="store_true", help="commencer un nouveau cycle après avoir terminé le précédent")
    parser.add_argument("--readings", action="store_true", help="afficher les cycles de lecture du document")
    parser.add_argument("--no-visual-hints", action="store_true", help="désactiver le repérage local des images et tracés PDF")
    parser.add_argument('--formulas', choices=('auto', 'off', 'text', 'model', 'hybrid'), default='auto', help='repérage des formules PDF (auto si installé)')
    parser.add_argument('--prepare', action='store_true', help='préparer le cache enrichi du PDF, sans ouvrir la mémoire de lecture')
    parser.add_argument('--goal', type=positive, help='objectif quotidien de mots (15000 par défaut, mémorisé)')
    parser.add_argument('--daily', action='store_true', help='afficher les mots validés aujourd’hui et l’objectif')
    parser.add_argument('--focus-minutes', type=focus_minutes, help='durée du prochain minuteur, au moins 5 minutes ; ne démarre pas le focus')
    parser.add_argument("-e", "--encoding", default="utf-8-sig", help="encodage du texte (défaut : UTF-8)")
    parser.add_argument("-R", "--raw", action="store_true", help="afficher le code source des fichiers Markdown au lieu de l'aperçu")
    parser.add_argument("-S", "--state", type=Path, default=state_path(), help="chemin de la base SQLite")
    parser.add_argument("-H", "--history", action="store_true", help="choisir ou afficher les lectures mémorisées")
    parser.add_argument("-p", "--status", action="store_true", help="afficher la position du fichier en JSON")
    args = parser.parse_args(argv)
    direct_file = args.file is not None
    args.mode = {"l": "lines", "w": "words", "s": "scroll"}.get(args.mode, args.mode)
    args.size = args.size or (120 if args.mode == "words" else 15)
    importing = args.clipboard or args.paste
    saved_action = importing or args.saved_name is not None or args.library
    catalog_action = args.catalog or args.download_library or args.download_book is not None or args.attach_book is not None or args.open_book is not None
    folder_action = args.folder is not None
    bare_launch = (args.file is None and not saved_action and not catalog_action and not folder_action
                   and not args.history and not args.daily and args.goal is None and not args.prepare)
    if args.file and (saved_action or catalog_action or folder_action):
        parser.error('choisissez un fichier ou une action de bibliothèque')
    if folder_action and (saved_action or catalog_action or args.history or args.daily or args.prepare
                          or args.goal is not None or args.status or args.readings or args.new_reading):
        parser.error('--folder configure seul le dossier de découverte')
    if args.name is not None and not importing:
        parser.error('--name nécessite --clipboard ou --paste')
    if (saved_action or catalog_action) and (args.history or args.daily or args.prepare):
        parser.error('la bibliothèque ne se combine pas avec --history, --daily ou --prepare')
    if args.library and (args.status or args.readings or args.new_reading or args.restart
                         or args.goal is not None or args.focus_minutes is not None):
        parser.error('--library liste les textes et s’utilise sans option de progression ou de réglage mémorisé')
    if args.new_reading and (args.restart or args.status or args.history or args.readings or args.daily):
        parser.error("--new-reading s'utilise seul avec les options de lecture")
    if bare_launch and (args.status or args.readings or args.new_reading or args.restart):
        parser.error('cette option nécessite un document')
    if args.daily and (args.status or args.history or args.readings):
        parser.error('--daily s’utilise sans autre option de consultation')
    if args.prepare and (not args.file or args.history or args.status or args.readings or args.new_reading
                         or args.daily or args.goal is not None or args.focus_minutes is not None):
        parser.error('--prepare nécessite un PDF et s’utilise sans option de mémoire')
    memory = None
    visual_index = None
    try:
        if args.prepare:
            return prepare_document(args.file.expanduser().resolve(strict=True), args.formulas)
        memory = Memory(args.state)
        if folder_action:
            folder = args.folder.expanduser().resolve(strict=True)
            if not folder.is_dir():
                raise ValueError(f'Le dossier de lecture est invalide : {folder}')
            previous = memory.daily.get('reading_folder', '')
            if previous and Path(previous).expanduser() != folder:
                with memory.db:
                    memory.db.execute('DELETE FROM discovered_documents')
            memory.daily.set('reading_folder', folder)
            discovered, total = memory.discover(folder)
            print(f'Dossier de lecture mémorisé : {folder} · {discovered} nouveau(x) sur {total} document(s).')
            print('Lancez désormais simplement : reader')
            return 0
        if bare_launch:
            configured = memory.daily.get('reading_folder', '')
            if not configured:
                raise ValueError('Aucun dossier de lecture configuré. Faites-le une fois avec : reader --folder CHEMIN')
            folder = Path(configured).expanduser()
            discovered, total = memory.discover(folder)
            args.history = True
            if not sys.stdin.isatty() or not sys.stdout.isatty():
                print(f'Dossier analysé : {discovered} nouveau(x) sur {total} document(s).')
        if catalog_action:
            catalog = CuratedLibrary(memory.db)
            if args.catalog:
                if sys.stdin.isatty() and sys.stdout.isatty():
                    selected = curses.wrapper(select_item, catalog)
                    if selected is None:
                        return 0
                    args.file = catalog.path(selected)
                    args.speech_model = args.speech_model or speech_model_for_language(
                        catalog.item(selected).get('language'))
                else:
                    print(catalog.summary())
                    return 0
            elif args.download_library:
                outcomes = catalog.download_all()
                for item_id, path, error in outcomes:
                    if path:
                        print(f'Téléchargé : {catalog.item(item_id)["title"]} → {path}')
                    else:
                        print(f'Non téléchargé : {item_id} — {error}', file=sys.stderr)
                return int(any(error for _, _, error in outcomes))
            elif args.download_book:
                path = catalog.download(args.download_book)
                print(path)
                return 0
            elif args.attach_book:
                item_id, filename = args.attach_book
                path = catalog.attach(item_id, filename)
                print(f'Document rattaché : {catalog.item(item_id)["title"]} → {path}')
                return 0
            elif args.open_book:
                args.file = catalog.path(args.open_book)
                if args.file is None:
                    item = catalog.item(args.open_book)
                    if item.get('download_url'):
                        raise ValueError(f"Document absent ; téléchargez-le avec reader --download-book {args.open_book}.")
                    raise ValueError(f"Document absent ; ajoutez votre fichier avec reader --attach-book {args.open_book} CHEMIN. Source : {item['url']}")
                args.speech_model = args.speech_model or speech_model_for_language(
                    catalog.item(args.open_book).get('language'))
        if saved_action:
            library = SavedTexts(memory.db, args.state)
            if args.library:
                entries = library.entries()
                for name, created, position, length in entries:
                    print(f'{position / max(1, length):6.1%}  {created} UTC  {name}')
                if not entries:
                    print('Aucun texte importé. Utilisez reader --clipboard --name "Mon texte".')
                return 0
            if args.saved_name is not None:
                args.file = library.find(args.saved_name)
            else:
                name = args.name
                if name is None:
                    if not sys.stdin.isatty():
                        raise ValueError('Indiquez --name pour nommer le texte importé.')
                    name = input('Nom du texte : ')
                if args.clipboard:
                    imported_text = clipboard_text()
                else:
                    if sys.stdin.isatty():
                        print('Collez votre texte, puis Entrée et Ctrl-D sur une ligne vide.', flush=True)
                    imported_text = sys.stdin.read()
                args.file = library.save(name, imported_text)
                if not sys.stdin.isatty() and not (args.status or args.readings):
                    print(f'Texte sauvegardé : {name}. Reprendre avec reader --open {json.dumps(name, ensure_ascii=False)}')
                    return 0
        if args.goal is not None:
            memory.daily.set_goal(args.goal)
        if args.focus_minutes is not None:
            memory.daily.set('focus_minutes', args.focus_minutes)
        if args.daily or (args.file is None and args.goal is not None):
            print(f'{memory.daily.words()}/{memory.daily.goal} mots · {memory.daily.day} (jour local)')
            return 0
        if args.history:
            history = memory.history()
            if sys.stdin.isatty() and sys.stdout.isatty():
                selected = curses.wrapper(select_history, history)
                if selected is None:
                    return 0
                args.file = selected
                args.history = False
            else:
                for path, position, length, updated, seconds in history:
                    state = f'{position / length:6.1%}  lu {duration(seconds)}' if length else 'nouveau         '
                    print(f"{state}  {updated} UTC  {path}")
                return 0
        original_path = args.file.expanduser().resolve(strict=True)
        path = original_path
        if direct_file and not (args.status or args.readings) and sys.stdin.isatty() and sys.stdout.isatty():
            configured = memory.daily.get('reading_folder', '')
            if configured:
                path = durable_reading_copy(path, configured)
        args.speech_model = args.speech_model or 'phonon:40m-fr'
        source, page_starts = load_document(path, args.encoding, with_pages=True)
        memory.relocate(original_path, path, source)
        source_position, changed = memory.resume(path, source)
        if args.new_reading:
            if not sys.stdin.isatty() or not sys.stdout.isatty():
                raise ValueError("--new-reading nécessite un terminal interactif.")
            memory.new_reading(path, source)
            source_position = 0
        cycles = memory.cycles(path, source)
        completed = sum(row[1] for row in cycles)
        if args.readings:
            for number, complete, seconds, historical, started, finished in cycles:
                label = "terminée" if complete else "en cours"
                print(f"Lecture {number} · {label} · {duration(seconds)}" + (" · fin importée, durée historique non attribuée" if historical else ""))
            if not cycles:
                print("Aucun cycle enregistré ; ouvrez le document pour commencer.")
            return 0
        text, offsets = source, None
        position = source_position
        if path.suffix.lower() in (".md", ".markdown", ".mdown") and not args.raw:
            text, offsets = markdown_preview(source)
            if not text.strip():
                raise ValueError("Aucun texte à afficher dans l'aperçu Markdown. Essayez --raw.")
            position = bisect_left(offsets, position)
        stats = memory.timing(path, text, changed)
        if args.status:
            words = WordIndex(text)
            seconds, basis, rate = remaining_estimate(words, position, stats, args.auto or args.mode == "scroll", args.wpm)
            print(json.dumps(dict(
                path=str(path), position=source_position, length=len(source),
                percent=round(source_position / len(source) * 100, 2), changed=changed,
                reading_seconds=round(stats.seconds, 2), remaining_words=words.count(position),
                estimated_remaining_seconds=None if seconds is None else round(seconds, 1),
                estimate_basis=basis, estimated_wpm=None if rate is None else round(rate, 1),
                speech_model=args.speech_model,
                reading_number=cycles[-1][0] if cycles else 1,
                completed_readings=completed, completed_rereadings=max(0, completed - 1),
                daily_date=memory.daily.day, daily_words=memory.daily.words(), daily_goal=memory.daily.goal,
                pdf_page=min(len(page_starts), bisect_right(page_starts, source_position)) if page_starts else None,
                pdf_pages=len(page_starts) if page_starts else None,
            ), ensure_ascii=False))
            return 0
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            raise ValueError("La lecture interactive nécessite un terminal. Utilisez --status pour consulter la progression.")
        locale.setlocale(locale.LC_ALL, "")
        terminal_settings = termios.tcgetattr(sys.stdin.fileno())
        if page_starts and not args.no_visual_hints:
            if args.formulas not in ('auto', 'off') and not formulas_available(args.formulas):
                raise ValueError('Repérage enrichi absent : lancez ./install.sh --layout.')
            visual_index = PdfVisualIndex(path, source, page_starts)
            if formulas_available(args.formulas):
                try:
                    visual_index = EnrichedIndex(visual_index, FormulaIndex(
                        path, visual_index.folder.name,
                        min(len(page_starts), bisect_right(page_starts, source_position)), args.formulas,
                        signature=visual_index.signature))
                except OSError as error:
                    print(f'Repérage enrichi indisponible : {error}', file=sys.stderr)
        try:
            curses.wrapper(run_with_focus, text, path, memory, args, 0 if args.restart else position, changed, source, offsets, stats, page_starts, visual_index)
        finally:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, terminal_settings)
        print(f"Position sauvegardée dans {args.state.expanduser()}")
        return 0
    except KeyboardInterrupt:
        print('\nPréparation interrompue ; pages déjà préparées conservées.' if args.prepare
              else "\nLecture interrompue ; position sauvegardée.")
        return 130
    except (OSError, ValueError, LookupError, EOFError, sqlite3.Error, curses.error) as error:
        print(f"reader : {error}", file=sys.stderr)
        return 1
    finally:
        if visual_index:
            visual_index.close()
        if memory:
            memory.close()


if __name__ == "__main__":
    sys.exit(main())
