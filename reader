#!/usr/bin/env python3
"""Lecteur de terminal avec reprise automatique (Python 3.10+)."""

import argparse
from bisect import bisect_left
import curses
import hashlib
import json
import locale
from html.parser import HTMLParser
import os
from pathlib import Path
import re
import shutil
import sqlite3
import subprocess
import sys
import termios
import time
import unicodedata


def state_path():
    root = os.environ.get("XDG_STATE_HOME")
    return (Path(root).expanduser() if root else Path.home() / ".local/state") / "reader/reading.sqlite3"


class Memory:
    def __init__(self, path):
        path = Path(path).expanduser()
        path.parent.mkdir(parents=True, exist_ok=True)
        self.db = sqlite3.connect(path)
        self.db.execute("""CREATE TABLE IF NOT EXISTS documents (
            path TEXT PRIMARY KEY, digest TEXT NOT NULL, position INTEGER NOT NULL,
            length INTEGER NOT NULL, updated TEXT NOT NULL)""")
        self.db.commit()

    def resume(self, path, text):
        row = self.db.execute("SELECT digest, position FROM documents WHERE path = ?", (str(path),)).fetchone()
        digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
        changed = row is not None and row[0] != digest
        return (min(max(row[1], 0), len(text)) if row and not changed else 0), changed

    def save(self, path, text, position):
        digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
        with self.db:
            self.db.execute("""INSERT INTO documents VALUES (?, ?, ?, ?, datetime('now'))
                ON CONFLICT(path) DO UPDATE SET digest=excluded.digest,
                position=excluded.position, length=excluded.length, updated=excluded.updated""",
                (str(path), digest, position, len(text)))

    def history(self):
        return self.db.execute("SELECT path, position, length, updated FROM documents ORDER BY updated DESC").fetchall()

    def close(self):
        self.db.close()


def load_document(path, encoding):
    if path.suffix.lower() == ".pdf":
        if not shutil.which("pdftotext"):
            raise ValueError("PDF : installez Poppler avec `brew install poppler`.")
        result = subprocess.run(
            ["pdftotext", "-layout", "-enc", "UTF-8", str(path), "-"],
            capture_output=True, check=False,
        )
        if result.returncode:
            raise ValueError("Extraction PDF impossible : " + result.stderr.decode("utf-8", errors="replace").strip())
        text = result.stdout.decode("utf-8")
    else:
        text = path.read_text(encoding=encoding)
    # Stable offsets refer to this normalized text, not PDF pages or source bytes.
    text = text.replace("\r\n", "\n").replace("\r", "\n").replace("\f", "\n\n").expandtabs(4)
    text = "".join(c for c in text if c in "\n" or not unicodedata.category(c).startswith("C"))
    if not text.strip():
        raise ValueError("Aucun texte lisible. Un PDF scanné nécessite une reconnaissance OCR préalable.")
    return text


class PreviewHTML(HTMLParser):
    """Keep HTML text, hiding decorative tags and explicitly hidden content."""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack = []
        self.output = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        hidden = (any(item[1] for item in self.stack) or tag in ("script", "style", "head")
                  or "hidden" in attrs or "display:none" in (attrs.get("style") or "").replace(" ", "").lower())
        if not hidden and tag == "br":
            self.output.append("\n")
        if not hidden and tag == "img" and attrs.get("alt"):
            self.output.append(attrs["alt"])
        if tag not in ("img", "br", "hr", "meta", "link", "input", "wbr", "source"):
            self.stack.append((tag, hidden))

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        self.handle_endtag(tag)

    def handle_endtag(self, tag):
        for index in range(len(self.stack) - 1, -1, -1):
            if self.stack[index][0] == tag:
                del self.stack[index:]
                break

    def handle_data(self, data):
        if not any(item[1] for item in self.stack):
            self.output.append(data)

    def convert(self, text):
        self.output = []
        self.feed(text)
        return "".join(self.output)


def markdown_preview(source):
    """Render common Markdown as terminal text, mapping back to source positions.

    Positions within a transformed line are interpolated; unchanged code lines
    keep exact offsets. This also migrates existing raw-Markdown reading positions.
    """
    references = set(re.findall(r"(?m)^ {0,3}\[([^\]]+)\]:", source))
    html = PreviewHTML()

    def inline(line):
        code = []

        def protect(match):
            code.append(match.group(2).replace("\n", " "))
            return f"\x00{len(code) - 1}\x00"

        line = re.sub(r"(?<!\\)(`+)(.+?)\1", protect, line)

        def protect_escape(match):
            code.append(match[1])
            return f"\x00{len(code) - 1}\x00"

        line = re.sub(r"\\([\\`*_{}\[\]()#+.!>|~-])", protect_escape, line)
        line = re.sub(r"\[\^[^\]]+\]", "", line)
        line = re.sub(r"!?\[([^\]]*)\]\((?:[^()\n]|\([^()\n]*\))*\)", r"\1", line)
        line = re.sub(r"!?\[([^\]]+)\]\[([^\]]*)\]", lambda m: m[1] if (m[2] or m[1]) in references else m[0], line)
        line = re.sub(r"\[([^\]]+)\]", lambda m: m[1] if m[1] in references else m[0], line)
        line = re.sub(r"<((?:https?://|mailto:)[^>]+)>", r"\1", line)
        line = html.convert(line)
        for delimiter in (r"\*\*", "__", "~~", r"\*", "_"):
            line = re.sub(r"(?<!\w)" + delimiter + r"(?=\S)(.+?)(?<=\S)" + delimiter + r"(?!\w)", r"\1", line)
        return re.sub(r"\x00(\d+)\x00", lambda m: code[int(m[1])], line)

    output, offsets = [], []
    source_start = 0
    fence = None
    in_definition = False
    for original in source.splitlines(keepends=True):
        line = original.rstrip("\n")
        rendered = None
        marker = re.match(r"^ {0,3}(`{3,}|~{3,})(.*)$", line)
        if fence:
            if marker and marker[1][0] == fence[0] and len(marker[1]) >= len(fence) and not marker[2].strip():
                fence = None
            else:
                rendered = line
        elif marker:
            fence = marker[1]
        elif re.match(r"^ {0,3}\[[^\]]+\]:", line):
            in_definition = True
        elif in_definition and (not line.strip() or line.startswith("    ")):
            pass
        else:
            in_definition = False
            if line.startswith("    "):
                rendered = line
            elif re.fullmatch(r"\s*(?:[-*_]\s*){3,}", line) or re.fullmatch(r"\s*[=-]{2,}\s*", line):
                rendered = ""
            elif "|" in line and re.fullmatch(r"[\s|:\-]+", line):
                rendered = None
            else:
                line = re.sub(r"^ {0,3}#{1,6}\s+(.+?)(?:\s+#+)?\s*$", r"\1", line)
                line = re.sub(r"^(\s*)>\s?", r"\1│ ", line)
                line = re.sub(r"^(\s*)[-+*]\s+\[([ xX])\]\s+", lambda m: m[1] + ("☐ " if m[2] == " " else "☑ "), line)
                line = re.sub(r"^(\s*)[-+*]\s+", r"\1• ", line)
                rendered = inline(line)
        if rendered is not None:
            rendered += "\n" if original.endswith("\n") else ""
            # Collapse empty decorative lines, retaining paragraph breaks.
            if rendered.strip() or (output and output[-1].strip()):
                output.append(rendered)
                offsets.extend(source_start + min(len(original) - 1, i * len(original) // max(1, len(rendered))) for i in range(len(rendered)))
        source_start += len(original)
    return "".join(output), offsets + [len(source)]


def cell_width(char):
    if unicodedata.combining(char):
        return 0
    return 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1


def rows(text, start, end, width, limit):
    """Return visual rows with exact source offsets, including consumed whitespace."""
    result = []
    while start < end and len(result) < limit:
        cursor, cells, last_space = start, 0, None
        while cursor < end and text[cursor] != "\n":
            advance = cell_width(text[cursor])
            if cells + advance > width:
                break
            cells += advance
            cursor += 1
            if text[cursor - 1].isspace():
                last_space = cursor
        if cursor < end and text[cursor] == "\n":
            cursor += 1
        elif cursor < end and last_space is not None:
            cursor = last_space
        if cursor == start:
            cursor += 1
        result.append((start, cursor, text[start:cursor].rstrip("\n")))
        start = cursor
    return result


def page(text, position, mode, size, width, height):
    end = len(text)
    if mode == "words":
        count = 0
        for match in re.finditer(r"\S+\s*", text[position:]):
            count += 1
            if count == size:
                end = position + match.end()
                break
    limit = min(size, height) if mode in ("lines", "scroll") else height
    visible = rows(text, position, end, width, limit)
    return visible, visible[-1][1] if visible else position


def previous(text, position, mode, size, width, height):
    if mode == "words":
        matches = list(re.finditer(r"\S+", text[:position]))
        candidate = matches[max(0, len(matches) - size)].start() if matches else 0
        # A word batch may occupy several screens: return its last screen.
        screens = rows(text, candidate, position, width, len(text) + 1)
    else:
        screens = rows(text, 0, position, width, len(text) + 1)
    count = 1 if mode == "scroll" else min(size, height) if mode == "lines" else height
    return screens[max(0, len(screens) - count)][0] if screens else 0


def clipped(text, width):
    result, cells = [], 0
    for char in text:
        advance = cell_width(char)
        if cells + advance > width:
            break
        result.append(char)
        cells += advance
    return "".join(result)


def terminal_accent():
    """Keep the terminal background and fall back to monochrome when needed."""
    if "NO_COLOR" in os.environ:
        return curses.A_BOLD
    try:
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            return curses.color_pair(1)
    except curses.error:
        pass
    return curses.A_BOLD


def run_ui(screen, text, path, memory, args, position, changed, source=None, offsets=None):
    source = text if source is None else source

    def source_position():
        return offsets[position] if offsets is not None else position

    try:
        curses.curs_set(0)
    except curses.error:
        pass
    accent = terminal_accent()
    screen.timeout(100)
    auto = args.auto or args.mode == "scroll"
    paused = False
    speed = args.wpm
    deadline = None
    stack = []
    notice = "Fichier modifié : reprise au début." if changed else ""
    last_saved = None
    last_layout = None
    help_open = False
    help_offset = 0
    help_lines = [
        "Raccourcis de lecture", "",
        "n / Entrée / →    Passage suivant",
        "b / ←             Passage précédent, puis pause",
        "Espace            Avancer en manuel ; pause en auto",
        "a                 Activer ou suspendre l'automatique",
        "j / k             Réduire / augmenter le passage",
        "+ / -             Accélérer / ralentir de 25 mots/min",
        "g                 Revenir au début",
        "q                 Sauvegarder et quitter", "",
        "[ et ] règlent aussi la taille du passage.",
        "Police plus grande : utilisez le zoom du terminal.",
        "? / Échap          Fermer cette aide",
    ]

    def save():
        nonlocal last_saved
        if position != last_saved:
            memory.save(path, source, source_position())
            last_saved = position

    try:
        while True:
            save()
            height, width = screen.getmaxyx()
            screen.erase()

            def put(y, value, style=0, x=0):
                if 0 <= y < height:
                    try:
                        screen.addstr(y, x, clipped(value, max(0, width - x - 1)), style)
                    except curses.error:
                        pass

            if height < 8 or width < 35:
                put(0, "Agrandissez le terminal (35 × 8 min).")
                put(1, "q : quitter et sauvegarder")
                screen.refresh()
                key = screen.getch()
                deadline = None
                if key in (ord("q"), 27):
                    break
                continue

            spacious = height >= 14
            body_start = 5 if spacious else 3
            body_height = height - body_start - 4
            body_width = min(76, width - 6)
            body_left = (width - body_width) // 2
            layout = (body_height, body_width)
            if layout != last_layout:
                deadline = None
                last_layout = layout
            visible, end = page(text, position, args.mode, args.size, body_width, body_height)
            step = visible[0][1] if args.mode == "scroll" and visible else end
            done = position >= len(text)
            if done:
                auto = False
            if auto and not help_open and deadline is None:
                words = max(1, len(re.findall(r"\S+", text[position:step])))
                deadline = time.monotonic() + max(0.25, words * 60 / speed)

            put(0, path.name, curses.A_BOLD, x=2)
            mode_label = {"lines": "Lignes", "words": "Mots", "scroll": "Défilement"}[args.mode]
            reading_state = "Lecture terminée" if done else "En pause · aide" if help_open else "Lecture automatique" if auto else "En pause" if paused else "Lecture manuelle"
            metadata = f"{mode_label} · {speed} mots/min · {reading_state}"
            if width < 65:
                reading_state = "Fin" if done else "Pause" if help_open or paused else "Auto" if auto else "Manuel"
                metadata = f"{mode_label} · {speed} m/min · {reading_state}"
            put(1, metadata, accent, x=2)
            unit = "mots" if args.mode == "words" else "lignes"
            if spacious:
                setting = f"Passage : {args.size} {unit}"
                if width >= 65:
                    setting += "    j réduire · k augmenter"
                put(2, setting, x=2)
            put(body_start - 2 if spacious else 2, "─" * (width - 4), curses.A_DIM, x=2)
            if help_open:
                help_text = "\n".join(help_lines)
                help_view = [row[2] for row in rows(help_text, 0, len(help_text), body_width, len(help_text))]
                help_offset = min(help_offset, max(0, len(help_view) - body_height))
                for index, line in enumerate(help_view[help_offset:help_offset + body_height]):
                    put(body_start + index, line, curses.A_BOLD if help_offset + index == 0 else 0, x=body_left)
            else:
                for index, (_, _, line) in enumerate(visible):
                    put(body_start + index, line, x=body_left)
                if done:
                    put(body_start, "Lecture terminée.", curses.A_BOLD, x=body_left)
                    if body_height > 1:
                        put(body_start + 1, "g : relire · b : revenir", x=body_left)
            fraction = source_position() / len(source)
            bar_width = width - 10
            filled, remainder = divmod(int(bar_width * 8 * fraction), 8)
            partial = "▏▎▍▌▋▊▉"[remainder - 1] if remainder else ""
            bar = "█" * filled + partial + "░" * (bar_width - filled - bool(partial))
            put(height - 3, f"[{bar}] {fraction:6.1%}", accent)
            if help_open:
                put(height - 2, "↑/↓ : défiler · ?/Échap : retour")
                put(height - 1, "Lecture suspendue pendant l'aide", curses.A_DIM)
            else:
                put(height - 2, notice or "n suite · b retour · espace suite/pause", curses.A_DIM)
                put(height - 1, "j/k taille · ? aide · q quitter")
            screen.refresh()
            key = screen.getch()
            advance = False
            if key == ord("?") or (help_open and key == 27):
                help_open = not help_open
                help_offset = 0
                deadline = None
                continue
            if key in (ord("q"), 27):
                break
            if key == curses.KEY_RESIZE:
                deadline = None
                continue
            if help_open:
                if key in (curses.KEY_DOWN, curses.KEY_NPAGE, ord(" ")):
                    help_offset = min(max(0, len(help_view) - body_height), help_offset + 1)
                elif key in (curses.KEY_UP, curses.KEY_PPAGE):
                    help_offset = max(0, help_offset - 1)
                continue
            if key in (ord("n"), curses.KEY_RIGHT, curses.KEY_DOWN, 10, 13):
                advance = True
            elif key == ord(" "):
                if auto:
                    auto, deadline = False, None
                    paused = True
                else:
                    advance = True
            elif key == ord("a"):
                auto, deadline = not auto, None
                paused = not auto
            elif key in (ord("+"), ord("="), ord("-")):
                speed = max(10, min(3000, speed + (-25 if key == ord("-") else 25)))
                deadline = None
            elif key in (ord("j"), ord("k"), ord("["), ord("]")):
                amount = 10 if args.mode == "words" else 1
                args.size = max(1, args.size + (amount if key in (ord("k"), ord("]")) else -amount))
                deadline = None
                notice = f"Passage : {args.size} {unit} (limité à la fenêtre)."
            elif key in (ord("b"), curses.KEY_LEFT, curses.KEY_UP):
                position = stack.pop() if stack else previous(text, position, args.mode, args.size, body_width, body_height)
                paused = paused or auto
                auto, deadline = False, None
            elif key == ord("g"):
                stack.append(position)
                position, auto, deadline = 0, False, None
                paused = False
            elif key == -1 and auto and deadline is not None and time.monotonic() >= deadline:
                advance = True
            if advance and not done:
                stack.append(position)
                position = step
                paused = False
                deadline = None
                notice = ""
    finally:
        save()


def positive(value):
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError("La valeur doit être strictement positive.")
    return number


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("file", nargs="?", type=Path, help="fichier texte, Markdown ou PDF")
    parser.add_argument("-m", "--mode", choices=("l", "w", "s", "lines", "words", "scroll"), default="lines", help="l = lignes, w = mots, s = défilement (noms longs acceptés)")
    parser.add_argument("-s", "--size", type=positive, help="lignes ou mots par passage (défaut : 15 lignes / 120 mots)")
    parser.add_argument("-a", "--auto", action="store_true", help="avancer automatiquement")
    parser.add_argument("-w", "--wpm", type=positive, default=200, help="vitesse en mots/minute (défaut : 200)")
    parser.add_argument("-r", "--restart", action="store_true", help="reprendre au début")
    parser.add_argument("-e", "--encoding", default="utf-8-sig", help="encodage du texte (défaut : UTF-8)")
    parser.add_argument("-R", "--raw", action="store_true", help="afficher le code source des fichiers Markdown au lieu de l'aperçu")
    parser.add_argument("-S", "--state", type=Path, default=state_path(), help="chemin de la base SQLite")
    parser.add_argument("-H", "--history", action="store_true", help="afficher les lectures mémorisées")
    parser.add_argument("-p", "--status", action="store_true", help="afficher la position du fichier en JSON")
    args = parser.parse_args(argv)
    args.mode = {"l": "lines", "w": "words", "s": "scroll"}.get(args.mode, args.mode)
    args.size = args.size or (120 if args.mode == "words" else 15)
    if not args.file and not args.history:
        parser.error("indiquez un fichier ou --history")
    memory = None
    try:
        memory = Memory(args.state)
        if args.history:
            for path, position, length, updated in memory.history():
                print(f"{position / max(1, length):6.1%}  {updated} UTC  {path}")
            return 0
        path = args.file.expanduser().resolve(strict=True)
        text = load_document(path, args.encoding)
        position, changed = memory.resume(path, text)
        if args.status:
            print(json.dumps(dict(path=str(path), position=position, length=len(text), percent=round(position / len(text) * 100, 2), changed=changed), ensure_ascii=False))
            return 0
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            raise ValueError("La lecture interactive nécessite un terminal. Utilisez --status pour consulter la progression.")
        source, offsets = text, None
        if path.suffix.lower() in (".md", ".markdown", ".mdown") and not args.raw:
            text, offsets = markdown_preview(source)
            if not text.strip():
                raise ValueError("Aucun texte à afficher dans l'aperçu Markdown. Essayez --raw.")
            position = bisect_left(offsets, position)
        locale.setlocale(locale.LC_ALL, "")
        terminal_settings = termios.tcgetattr(sys.stdin.fileno())
        try:
            curses.wrapper(run_ui, text, path, memory, args, 0 if args.restart else position, changed, source, offsets)
        finally:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, terminal_settings)
        print(f"Position sauvegardée dans {args.state.expanduser()}")
        return 0
    except KeyboardInterrupt:
        print("\nLecture interrompue ; position sauvegardée.")
        return 130
    except (OSError, ValueError, LookupError, sqlite3.Error, curses.error) as error:
        print(f"reader : {error}", file=sys.stderr)
        return 1
    finally:
        if memory:
            memory.close()


if __name__ == "__main__":
    sys.exit(main())
